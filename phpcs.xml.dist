<?xml version="1.0"?>
<ruleset name="keyring">
  <description>Project layer over the bundled CiviKitchen standard.</description>

  <rule ref="CiviKitchen">
    <!-- CiviCRM's fluent API uses positional permission/strictness flags
         across the supported 6.12+ range; parameter names are not part of
         that cross-version contract. Keep the explicit booleans positional. -->
    <exclude name="CiviKitchen.Modern.NameBooleanArguments.UnnamedBoolean"/>
    <!-- Markdown tables and literal command examples are clearer unwrapped. -->
    <exclude name="Drupal.Files.TxtFileLineLength.TooLong"/>
  </rule>

  <file>.</file>
  <arg name="extensions" value="php"/>

  <!-- Generated / vendored code is not ours to style. -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/dist/*</exclude-pattern>
  <!-- Regenerated evidence from the e2e suites, not source. -->
  <exclude-pattern>*/tests/e2e/measure/out/*</exclude-pattern>
  <exclude-pattern>*.civix.php</exclude-pattern>
  <exclude-pattern>*/CRM/*/DAO/*</exclude-pattern>
</ruleset>
